// ======================================================
// FILE: /firestore.rules
// PROJECT: IATTV Website
// PURPOSE:
// Firestore security rules for public ministry content
// and the protected IATTV administration system.
// ======================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function callerAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function hasModule(name) {
      return isAdmin() && (
        callerAdmin().role == "admin" ||
        callerAdmin().role == "full" ||
        callerAdmin().role == name ||
        (callerAdmin().keys().hasAny(["roles"]) && name in callerAdmin().roles)
      );
    }

    function isFullAdmin() {
      return hasModule("full");
    }

    function canManageContent() {
      return hasModule("content") || hasModule("media");
    }

    function canManagePrayer() {
      return hasModule("prayer");
    }

    function canManageGiving() {
      return hasModule("giving");
    }

    function canReadGiving() {
      return hasModule("giving") || hasModule("accountant");
    }

    match /admins/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if resource.data.published == true || canManageContent();
      allow create, update, delete: if canManageContent();
    }

    match /siteSettings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isFullAdmin();
    }

    match /prayerRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if canManagePrayer();
    }

    match /givingMethods/{methodId} {
      allow read: if true;
      allow create, update, delete: if canManageGiving();
    }

    match /givingFunds/{fundId} {
      allow read: if canReadGiving()
                  || (resource.data.active == true && resource.data.isPublic == true);
      allow create, update, delete: if canManageGiving();
    }

    match /givingSettings/{documentId} {
      allow read: if canReadGiving();
      allow create, update, delete: if canManageGiving();
    }

    match /donors/{donorId} {
      allow read: if canReadGiving();
      allow create, update, delete: if canManageGiving();
    }

    match /donations/{donationId} {
      allow read: if canReadGiving();
      allow create, update, delete: if canManageGiving();
    }

    match /stripeEvents/{eventId} {
      allow read, create, update, delete: if canManageGiving();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}